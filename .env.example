# Copy to .env.local and fill in. Never commit .env.local.

# Which AI backend reads uploaded documents: "openai" or "mock".
# "mock" returns clearly-labelled DEMO data and needs no API key (for local demos).
EXTRACTION_PROVIDER=openai

# OpenAI API key (server-side only — never exposed to the browser).
OPENAI_API_KEY=

# Model used for extraction. Must support vision + structured outputs.
# gpt-4o (default, most accurate) · gpt-4o-mini / gpt-4.1-mini (much cheaper)
OPENAI_MODEL=gpt-4o

# Optional: a different model for reading scans and screenshots. Defaults to OPENAI_MODEL.
OPENAI_VISION_MODEL=

# Optional: any OpenAI-compatible endpoint (e.g. Google Gemini, OpenRouter).
# Leave empty for OpenAI itself.
OPENAI_BASE_URL=

# Flight search (Option 2): Duffel. Tokens are server-side only.
FLIGHT_PROVIDER=duffel
# "test" (default) uses the test token: test data only, no real bookings or money.
# "live" requires DUFFEL_LIVE_ACCESS_TOKEN and returns real fares (searches only; the app never books).
DUFFEL_ENV=test
DUFFEL_TEST_ACCESS_TOKEN=
DUFFEL_LIVE_ACCESS_TOKEN=

# Single persistent server, Node.js 22.13+. Back up this database and its WAL files.
PORTAL_DATABASE_PATH=data/portal.sqlite
# Generate a long random value. Used once at /login to create the first admin.
# Never use a public/default value; remove after initial setup.
PORTAL_SETUP_KEY=
